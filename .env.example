# Standalone Golden Compass backend (copy to .env locally; never commit .env)
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://gc_app:replace_me@localhost:5432/golden_compass
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional integrations; required only when the related feature is enabled.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=
MYSTOCKS_API_KEY=
FINNHUB_API_KEY=
